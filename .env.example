# VF Services Environment Variables Example
# Copy this file to .env and fill in your actual values

# JWT Secret for authentication
VF_JWT_SECRET=change-me-to-a-secure-secret

# PostgreSQL Configuration
POSTGRES_USER=vfuser
POSTGRES_PASSWORD=vfpass
POSTGRES_DB=vfdb

# Admin User Configuration
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@viloforge.com
ADMIN_PASSWORD=admin123

# RBAC/ABAC Cache TTL (in seconds)
RBAC_ABAC_CACHE_TTL=86400

# Cloudflare API Token (for Let's Encrypt DNS challenge)
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token

# Azure RM Proxy Authentication
# Required for azure-rm-proxy service
AZURE_TENANT_ID=your-azure-tenant-id
AZURE_CLIENT_ID=your-azure-client-id
AZURE_CLIENT_SECRET=your-azure-client-secret

# Optional: Enable mock mode for Azure RM Proxy (for testing)
# USE_MOCK=true